{
  "name": "paper-snapshot-cli",
  "version": "0.1.4",
  "description": "Paper Snapshot as a CLI. Copy and paste your real site directly into Paper as editable layers. No more screenshots.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "cli",
    "coding-agents",
    "design-tools",
    "effect",
    "paper",
    "paper-design",
    "paper-snapshot",
    "snapshot"
  ],
  "homepage": "https://github.com/jeremyosih/paper-snapshot#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremyosih/paper-snapshot.git"
  },
  "bin": {
    "paper-snapshot": "dist/bin.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "bun src/bin.ts",
    "check": "vp check && bun run typecheck && bun run knip",
    "lint": "vp lint --report-unused-disable-directives",
    "format": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "setup": "effect-tsgo patch"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.57.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oxlint/plugins": "1.82.0",
    "@types/node": "^26.2.0",
    "effect": "4.0.6",
    "fflate": "0.8.2",
    "knip": "6.34.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
