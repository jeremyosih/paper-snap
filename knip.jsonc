{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.ts!", "*.ts"],
  // The committed bundle is build output.
  "ignore": ["dist/**"],
  // Oxlint is pinned for Vite+'s dynamically loaded anti-slop plugins.
  "ignoreDependencies": ["oxlint", "@effect/language-service"],
}
